  "components": {
    "schemas": {
      "AccountKind": {
        "type": "string",
        "enum": [
          "cash",
          "bank",
          "credit_card",
          "crypto_wallet"
        ],
        "title": "AccountKind"
      },
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/AccountKind"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "archived_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "currency",
          "created_at",
          "archived_at"
        ],
        "title": "AccountResponse"
      },
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "Currency": {
        "type": "string",
        "enum": [
          "ARS",
          "USD",
          "BTC"
        ],
        "title": "Currency",
        "description": "Monedas admitidas. Sumar una es agregarla acá con su precisión."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorResponse",
        "description": "Toda respuesta de error: un código estable, nunca un mensaje traducido ni una traza."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse"
      },
      "MeResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "MeResponse"
      },
      "OpenAccountRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/AccountKind"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "currency"
        ],
        "title": "OpenAccountRequest"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "database": {
            "$ref": "#/components/schemas/ComponentStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse"
      },
      "RecoverRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "recovery_code": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "format": "password",
            "title": "Recovery Code",
            "writeOnly": true
          },
          "new_password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "New Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "recovery_code",
          "new_password"
        ],
        "title": "RecoverRequest"
      },
      "RecoverResponse": {
        "properties": {
          "recovery_code": {
            "type": "string",
            "title": "Recovery Code"
          }
        },
        "type": "object",
        "required": [
          "recovery_code"
        ],
        "title": "RecoverResponse"
      },
      "RegisterResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "recovery_code": {
            "type": "string",
            "title": "Recovery Code"
          }
        },
        "type": "object",
        "required": [
          "username",
          "recovery_code"
        ],
        "title": "RegisterResponse"
      },
      "RenameAccountRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "RenameAccountRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
