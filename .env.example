# Copiar este archivo a .env y completar los valores. .env nunca se commitea.

# Contraseña de PostgreSQL para el entorno local de Docker Compose.
# Usar solo letras y números: va dentro de una URL de conexión.
POSTGRES_PASSWORD=

# Entorno de la API: development, test o production.
RINDE_ENVIRONMENT=development

# Puerto local donde se publica la aplicación (por defecto 8080).
RINDE_WEB_PORT=8080

# Cookie de sesión con Secure. En Docker local (HTTP) va desactivada; en producción (HTTPS),
# siempre activa: el valor por defecto de la API es true.
RINDE_SESSION_COOKIE_SECURE=false
