// Configuración del despliegue en Cloudflare Workers (ADR-0005).
// API_ORIGIN no se escribe acá: la CI la inyecta con `wrangler deploy --var API_ORIGIN:<url>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rinde",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
