{
  "name": "rinde-web",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -b e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts && prettier --write src/shared/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@fontsource-variable/lexend": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.2",
    "@tanstack/react-query": "^5.102.8",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
